# ============================================
# Dodaci system — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local

# --- Gmail SMTP (for sending delivery emails) ---
# Use a Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Tropic Avokado <your-email@gmail.com>
EMAIL_CC=

# --- Google Sheets Integration ---
# Google Apps Script webhook URL for logging deliveries
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# --- Authentication ---
AUTH_USERNAME=admin
# Generate password hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
AUTH_PASSWORD_HASH=$2b$12$...
# Generate secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-secret-key-at-least-32-characters-long

# --- Vercel Blob Storage (for companies & delivery history) ---
# Get this from your Vercel project: Settings → Environment Variables
# Or run: vercel env pull
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
